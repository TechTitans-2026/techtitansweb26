VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: the admin access code is no longer a VITE_-prefixed variable.
# Anything prefixed VITE_ is bundled into the client JS in plain text, so it
# can never be a real secret. Set the real code as a server-side Supabase
# secret instead (never committed, never shipped to the browser):
#   supabase secrets set ADMIN_ACCESS_CODE=your_admin_access_code_here
# See supabase/functions/grant-admin/index.ts for where it's checked.
